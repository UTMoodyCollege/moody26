{% set classes = [
  'field',
  'field--name-' ~ field_name|clean_class,
  'field--type-' ~ field_type|clean_class,
  'field--label-' ~ label_display,
  'moody26-subsite-menu-field',
] %}

<ul{{ attributes.addClass(classes, 'moody26-subsite-menu') }}>
  {% for item in items %}
    {{ item.content }}
  {% endfor %}
</ul>
